{
  "mcpServers": {
    "lore": {
      "type": "http",
      "url": "${LORE_BASE_URL:-http://127.0.0.1:18901}/api/mcp?client_type=claudecode",
      "headers": {
        "Authorization": "Bearer ${LORE_API_TOKEN:-}"
      }
    },
    "lore-skills": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/local-skills-mcp/src/server.mjs",
        "--client-type",
        "claudecode"
      ],
      "env": {
        "LORE_HOME": "${LORE_HOME:-}",
        "LORE_BASE_URL": "${LORE_BASE_URL:-http://127.0.0.1:18901}",
        "LORE_CLIENT_TYPE": "claudecode",
        "LORE_SKILLS_ENABLED": "${LORE_SKILLS_ENABLED:-0}"
      }
    }
  }
}
