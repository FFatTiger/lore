{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/lifecycle-hooks.mjs"],
            "timeoutMs": 8000,
            "statusMessage": "Loading Lore lifecycle context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/lifecycle-hooks.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "Recalling Lore context"
          }
        ]
      }
    ]
  }
}
